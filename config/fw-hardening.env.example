# firewalla-dns-hardening: local settings
# Copy to /home/pi/.firewalla/config/fw-hardening.env and adjust.
# This file is sourced by every script. Never commit your real copy.

# Interface that carries client traffic. "br0" in bridge mode.
# In router mode this is usually the LAN bridge (check with: ip -br addr).
LAN_IF="br0"

# IPv4 address of the Firewalla on that interface.
# Leave empty to auto-detect from LAN_IF.
FW_IP=""

# A domain you trust to always resolve. Used as the "is DNS alive" control.
CONTROL_DOMAIN="example.com"

# Domain that is deliberately blackholed in config/canary.conf.
# Must be a domain that resolves normally on the internet.
CANARY_DOMAIN="example.net"

# Hagezi lists to load (dnsmasq format). See https://github.com/hagezi/dns-blocklists
#   tif.mini = threat intelligence (malware, phishing, C2), size-optimised
#   doh      = DNS-over-HTTPS / DoT resolver hostnames
#   fake     = fake shops, scams
HAGEZI_LISTS="tif.mini doh fake"

# Minimum number of entries a downloaded list must have before it replaces
# the current one. Protects against empty or truncated downloads.
MIN_LIST_ENTRIES=100

# Block outbound SMTP (tcp/25) from clients. Stops infected devices from
# sending spam directly. Normal mail clients use 587/465 and are unaffected.
BLOCK_SMTP=1

# healthchecks.io (or compatible) ping URL for the canary.
# Leave empty to disable external alerting (the canary still logs locally).
# Example: HC_URL="https://hc-ping.com/your-uuid-here"
HC_URL=""

# Number of consecutive failed canary runs before /fail is sent.
CANARY_FAIL_AFTER=3
